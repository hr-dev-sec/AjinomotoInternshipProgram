# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase PostgreSQL Connection String (Wajib untuk deployment GitHub -> Vercel)
# Ambil dari Supabase Dashboard -> Connect -> Transaction Pooler (port 6543) atau Session Pooler (port 5432)
SUPABASE_DB_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
DATABASE_URL=""

# Secret acak minimal 32 karakter untuk menandatangani token sesi login (wajib diisi di Vercel)
SESSION_SECRET="GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER"

# HR Admin Credentials (opsional; default awal ter-seed otomatis di database)
ADMIN_USERNAME="hr.mojokerto"
ADMIN_PASSWORD="CHANGE_ME"

# Optional Google Apps Script Web App REST API URL for hybrid sync
GAS_API_URL=""
